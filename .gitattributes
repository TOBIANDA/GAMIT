# ==============================================================================
# Godot 4 Industry-Standard .gitattributes for Cross-Platform Teams
# ==============================================================================

# Default to automatic text normalization with LF line endings
* text=auto eol=lf

# Godot Engine Text Formats
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.import text eol=lf
*.json text eol=lf
*.cfg text eol=lf
*.md text eol=lf
*.bat text eol=crlf

# Binary Media & Visual Assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg text
*.bmp binary

# Binary Audio Assets
*.mp3 binary
*.wav binary
*.ogg binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
